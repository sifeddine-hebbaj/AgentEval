# Copy this file to .env and fill in real values before running docker compose.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://agenteval:agenteval@localhost:5432/agenteval
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- LLM-as-judge provider (choose one) ---
JUDGE_PROVIDER=openai        # openai | anthropic | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
JUDGE_MODEL=gpt-4o-mini

# --- Object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agenteval-payloads

# --- Frontend ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
